{
  "manifest_version": 3,
  "name": "Price in INR",
  "version": "4.0",
  "description": "Hover over any price to instantly see the INR equivalent with configurable tax.",
  "permissions": ["storage"],
  "host_permissions": ["https://open.er-api.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["tooltip.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon.png"
  }
}
