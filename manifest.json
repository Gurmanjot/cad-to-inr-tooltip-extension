{
  "manifest_version": 3,
  "name": "Price in INR",
  "version": "3.0",
  "description": "Hover over any CAD price to instantly see the INR equivalent.",
  "permissions": [],
  "host_permissions": ["https://open.er-api.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["tooltip.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon.png"
  }
}
